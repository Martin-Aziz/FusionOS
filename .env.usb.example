NODE_ENV=production
PORT=4000
LOG_LEVEL=info
FUSIONOS_APP_IMAGE=fusionos/app:0.1.0
POSTGRES_USER=trios
POSTGRES_PASSWORD=trios
POSTGRES_DB=trios
POSTGRES_PORT=5432
REDIS_PORT=6379
PROXY_PORT=8080
DATABASE_URL=postgresql://trios:trios@postgres:5432/trios
REDIS_URL=redis://redis:6379
# Installer will replace this value with a generated secret if left unchanged.
DEVICE_TOKEN_SALT=replace-with-strong-random-secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
